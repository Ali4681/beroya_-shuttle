// =============================================================================
// Beroya On + — Prisma Schema (v1)
// =============================================================================
// المبادئ:
// 1) Multi-tenant: كل جدول تشغيلي يحمل institutionId لعزل البيانات.
// 2) فصل "الإعداد الثابت" (Route) عن "التنفيذ الفعلي" (Trip).
// 3) Soft delete عبر archivedAt (لا حذف فيزيائي للبيانات التشغيلية).
// 4) لا Permissions ديناميكية — Roles ثابتة فقط.
// 5) الموقع الحي (live location) في Redis، وPostgres يحفظ sampling للتاريخ.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum ShuttleRole {
  BEROYA_ADMIN
  INSTITUTION_ADMIN
  PARENT
  UNIVERSITY_STUDENT
  COMPANY_EMPLOYEE
  DRIVER
  ATTENDANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InstitutionType {
  SCHOOL
  UNIVERSITY
  COMPANY
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
}

/// من يملك/يشغّل الموارد داخل المؤسسة
enum OperationModel {
  BEROYA_OPERATED // بيرويا توفر المركبات والسائقين
  INSTITUTION_OPERATED // المؤسسة تملك كل شيء وتشترك بالنظام فقط
}

/// الجهة المالكة لمورد (سائق / مركبة)
enum OwnerType {
  BEROYA
  INSTITUTION
  DRIVER
}

enum ResourceStatus {
  ACTIVE
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  SUSPENDED
  UNDER_MAINTENANCE
}

enum RouteStatus {
  ACTIVE
  SUSPENDED
  STOPPED_TODAY
  TEMPORARILY_UNAVAILABLE
  UNDER_EDIT
}

enum TripDirection {
  OUTBOUND // ذهاب (من نقطة الانطلاق إلى المؤسسة)
  INBOUND // عودة
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStudentStatus {
  PENDING
  BOARDED
  NOT_BOARDED
  /// غياب سجّله ولي الأمر (مميّز عن NOT_BOARDED من المشرفة)
  ABSENT
  DROPPED_OFF
}

enum TripStopStatus {
  PENDING
  ARRIVED
  SKIPPED
}

enum PickupType {
  HOME
  MEETING_POINT
}

enum StopType {
  STUDENT_HOME
  MEETING_POINT
  INSTITUTION
  CUSTOM
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum StudentSubscriptionType {
  ROUND_TRIP
  OUTBOUND_ONLY
  INBOUND_ONLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  TERM
}

enum IncidentType {
  BREAKDOWN // عطل مركبة
  EMERGENCY // زر الطوارئ
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum TripAssignmentField {
  DRIVER
  VEHICLE
  ATTENDANT
}

enum TripEventType {
  TRIP_STARTED
  TRIP_COMPLETED
  TRIP_CANCELLED
  STOP_ARRIVED
  STUDENT_BOARDED
  STUDENT_NOT_BOARDED
  STUDENT_ABSENT
  STUDENT_DROPPED_OFF
  STUDENT_STATUS_CORRECTED
  DELAY_DETECTED
  BREAKDOWN_REPORTED
  EMERGENCY_TRIGGERED
  DRIVER_CHANGED
  VEHICLE_CHANGED
  ATTENDANT_CHANGED
  ATTENDANT_BOARDED
  ATTENDANT_BOARDING_CLEARED
  ORIGIN_OVERRIDDEN
  TIME_OVERRIDDEN
  TRACKING_LOST
  TRACKING_RESUMED
  INCIDENT_RESOLVED
}

enum NotificationAudience {
  ALL_PARENTS
  ROUTE_PARENTS
  ALL_UNIVERSITY_STUDENTS
  ROUTE_UNIVERSITY_STUDENTS
  ALL_DRIVERS
  ROUTE_DRIVERS
  ALL_ATTENDANTS
  ROUTE_ATTENDANTS
}

enum NotificationOrigin {
  MANUAL // أرسلها مسؤول المؤسسة
  SYSTEM // تأخير / تغيير حالة خط
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum TripAlertType {
  ARRIVAL_SOON // تنبيه اقتراب الباص
  DELAY // تنبيه التأخير (مرة واحدة فقط)
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// =============================================================================
// CORE: USERS / SESSIONS / DEVICES
// =============================================================================

/// كل مستخدم حقيقي للنظام (أدمن بيرويا، مسؤول مؤسسة، ولي أمر، طالب جامعة، سائق، مشرفة)
/// ملاحظة: institutionId = null لمستخدمي بيرويا وسائقي/مركبات بيرويا.
/// التحقق من تكرار الهاتف عند institutionId = null يُفرض على مستوى التطبيق
/// (Postgres يعتبر NULL غير متساوية في الـ unique index).
model ShuttleUser {
  id              String      @id @default(uuid())
  fullName        String
  phone           String
  // Login is email+password. API create DTOs require both; nullable only for legacy rows.
  email           String?     @unique
  passwordHash    String?
  role            ShuttleRole
  status          UserStatus  @default(ACTIVE)
  institutionId   String?
  branchId        String?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  archivedAt      DateTime?

  institution Institution?       @relation("InstitutionMembers", fields: [institutionId], references: [id])
  branch      InstitutionBranch? @relation(fields: [branchId], references: [id])

  sessions UserSession[]
  devices  UserDevice[]

  managedInstitutions    Institution[]             @relation("InstitutionPrimaryAdmin")
  driverProfile          DriverProfile?
  attendantProfile       AttendantProfile?
  universityProfile      UniversityStudentProfile?
  guardedStudents        SchoolStudent[]           @relation("StudentGuardian")
  arrivalPreferences     ParentArrivalPreference[]
  createdRouteExceptions StudentRouteException[]   @relation("RouteExceptionCreatedBy")
  markedTripStudents     TripStudent[]             @relation("TripStudentMarkedBy")
  reportedIncidents      TripIncident[]            @relation("IncidentReportedBy")
  resolvedIncidents      TripIncident[]            @relation("IncidentResolvedBy")
  tripEvents             TripEvent[]               @relation("TripEventActor")
  tripAssignmentChanges  TripAssignmentHistory[]   @relation("AssignmentChangedBy")
  sentNotifications      ShuttleNotification[]     @relation("NotificationSentBy")
  notificationRecipients NotificationRecipient[]
  tripAlertDeliveries    TripAlertDelivery[]
  auditLogs              ShuttleAuditLog[]         @relation("AuditActor")
  recordedPlannedAbsences StudentPlannedAbsence[]  @relation("PlannedAbsenceRecordedBy")
  attendantBoardedTrips  ShuttleTrip[]             @relation("TripAttendantBoardedBy")

  @@unique([phone, institutionId])
  @@index([institutionId, role, status])
  @@index([phone])
}

/// جلسات الدخول — لإدارة Refresh Token و Logout / Logout All
model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user ShuttleUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// أجهزة المستخدم + FCM Token لإشعارات Push
model UserDevice {
  id         String         @id @default(uuid())
  userId     String
  deviceId   String
  fcmToken   String
  platform   DevicePlatform
  /// لغة تطبيق الجهاز للإشعارات: ar | en (افتراضي عربي)
  locale     String         @default("ar")
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user ShuttleUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([fcmToken])
}

// =============================================================================
// INSTITUTIONS
// =============================================================================

model Institution {
  id                 String            @id @default(uuid())
  name               String
  displayName        String?
  type               InstitutionType
  operationModel     OperationModel    @default(INSTITUTION_OPERATED)
  status             InstitutionStatus @default(ACTIVE)
  statusReason       String?
  primaryAdminUserId String?
  contactPhone       String?
  contactEmail       String?
  /// مدينة العرض (هيدر الخرائط / التطبيقات)
  city               String?
  address            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  archivedAt         DateTime?

  primaryAdmin ShuttleUser?  @relation("InstitutionPrimaryAdmin", fields: [primaryAdminUserId], references: [id])
  members      ShuttleUser[] @relation("InstitutionMembers")

  settings      InstitutionSettings?
  branding      InstitutionBranding?
  branches      InstitutionBranch[]
  subscriptions InstitutionSubscription[]

  schoolStudents     SchoolStudent[]
  universityStudents UniversityStudentProfile[]
  meetingPoints      MeetingPoint[]
  routes             ShuttleRoute[]
  drivers            DriverProfile[]
  vehicles           ShuttleVehicle[]
  attendants         AttendantProfile[]
  trips              ShuttleTrip[]
  notifications      ShuttleNotification[]
  auditLogs          ShuttleAuditLog[]
  holidays           InstitutionHoliday[]

  @@index([type, status])
  @@index([operationModel])
}

/// عطل المؤسسة / الوطنية — تُستخدم لرفض غياب الأهل خارج أيام الدراسة
model InstitutionHoliday {
  id            String   @id @default(uuid())
  institutionId String
  date          DateTime @db.Date
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, date])
  @@index([institutionId, date])
}

model InstitutionSettings {
  id                               String   @id @default(uuid())
  institutionId                    String   @unique
  timezone                         String   @default("Asia/Damascus")
  defaultDelayThresholdMinutes     Int      @default(10)
  defaultParentArrivalAlertMinutes Int      @default(10)
  gpsStaleAfterSeconds             Int      @default(120)
  locationPingIntervalSeconds      Int      @default(15)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model InstitutionBranding {
  id                     String   @id @default(uuid())
  institutionId          String   @unique
  useInstitutionIdentity Boolean  @default(false)
  logoUrl                String?
  primaryColor           String?
  secondaryColor         String?
  welcomeMessage         String?
  supportPhone           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model InstitutionBranch {
  id            String         @id @default(uuid())
  institutionId String
  name          String
  address       String?
  /// موقع الفرع = نقطة الوصول/الانطلاق للخطوط
  latitude      Float?
  longitude     Float?
  status        ResourceStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  members            ShuttleUser[]
  schoolStudents     SchoolStudent[]
  universityStudents UniversityStudentProfile[]
  meetingPoints      MeetingPoint[]
  routes             ShuttleRoute[]
  trips              ShuttleTrip[]
  notifications      ShuttleNotification[]

  @@unique([institutionId, name])
  @@index([institutionId, status])
}

/// الاشتراك بين المؤسسة وبيرويا (المؤسسة هي التي تدفع)
model InstitutionSubscription {
  id            String             @id @default(uuid())
  institutionId String
  billingPeriod BillingPeriod
  status        SubscriptionStatus @default(PENDING)
  startsAt      DateTime
  endsAt        DateTime
  agreedAmount  Decimal            @db.Decimal(12, 2)
  currencyCode  String             @default("USD")
  notes         String?
  activatedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
  @@index([status, endsAt])
}

// =============================================================================
// RESOURCES: DRIVERS / VEHICLES / ATTENDANTS
// =============================================================================

model DriverProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  /// null = سائق تابع لبيرويا (غير مربوط بمؤسسة)
  institutionId    String?
  ownerType        OwnerType
  nationalId       String?
  licenseNumber    String?
  licenseExpiry    DateTime?
  /// مركبة افتراضية مرتبطة بالسائق
  primaryVehicleId String?        @unique
  /// عدد الرحلات المسموح بها يومياً لهذا السائق داخل المؤسسة (1–10)، لتشغيل بيرويا
  dailyTripsLimit  Int?
  status           ResourceStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  archivedAt       DateTime?

  user           ShuttleUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution?    @relation(fields: [institutionId], references: [id])
  primaryVehicle ShuttleVehicle? @relation("DriverPrimaryVehicle", fields: [primaryVehicleId], references: [id], onDelete: SetNull)

  ownedVehicles    ShuttleVehicle[] @relation("VehicleOwnerDriver")
  defaultForRoutes ShuttleRoute[]
  trips            ShuttleTrip[]

  @@index([institutionId, status])
  @@index([ownerType, status])
}

model ShuttleVehicle {
  id              String        @id @default(uuid())
  /// null = مركبة تابعة لبيرويا (غير مربوطة بمؤسسة)
  institutionId   String?
  ownerType       OwnerType
  /// عند ownerType=DRIVER: السائق المالك
  ownerDriverId   String?
  plateNumber     String
  vehicleType     String?
  capacity        Int?
  licenseExpiry   DateTime?
  insuranceExpiry DateTime?
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  institution      Institution?   @relation(fields: [institutionId], references: [id])
  ownerDriver      DriverProfile? @relation("VehicleOwnerDriver", fields: [ownerDriverId], references: [id], onDelete: SetNull)
  primaryForDriver DriverProfile? @relation("DriverPrimaryVehicle")

  defaultForRoutes ShuttleRoute[]
  trips            ShuttleTrip[]

  @@unique([plateNumber])
  @@index([institutionId, status])
  @@index([ownerType, status])
  @@index([ownerDriverId])
}

/// المشرفة — تابعة للمؤسسة حصراً
model AttendantProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  institutionId String
  nationalId    String?
  status        ResourceStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  user        ShuttleUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// علاقة 1-1 مع الخط في النسخة الأولى (مشرفة واحدة لكل خط، وخط واحد لكل مشرفة)
  defaultForRoute ShuttleRoute?
  trips           ShuttleTrip[]

  @@index([institutionId, status])
}

// =============================================================================
// STUDENTS / PARENTS
// =============================================================================

/// طالب المدرسة — ليس مستخدماً للنظام، مجرد ملف داخل المؤسسة
model SchoolStudent {
  id               String                  @id @default(uuid())
  institutionId    String
  branchId         String
  fullName         String
  photoUrl         String?
  grade            String?
  section          String?
  guardianUserId   String
  subscriptionType StudentSubscriptionType @default(ROUND_TRIP)
  status           StudentStatus           @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  archivedAt       DateTime?

  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch       InstitutionBranch @relation(fields: [branchId], references: [id])
  guardianUser ShuttleUser       @relation("StudentGuardian", fields: [guardianUserId], references: [id])

  pickupConfig       StudentPickupConfig?
  routeAssignments   StudentRouteAssignment[]
  routeExceptions    StudentRouteException[]
  routeStopLinks     RouteStopStudent[]
  tripStudents       TripStudent[]
  arrivalPreferences ParentArrivalPreference[]
  plannedAbsences    StudentPlannedAbsence[]

  @@index([institutionId, branchId, status])
  @@index([guardianUserId])
  @@index([institutionId, fullName])
  @@index([institutionId, archivedAt])
}

/// غياب مخطّط من ولي الأمر قبل/بدون توليد رحلة لذلك اليوم
model StudentPlannedAbsence {
  id               String    @id @default(uuid())
  studentId        String
  date             DateTime  @db.Date
  reason           String?
  recordedByUserId String
  appliedAt        DateTime?
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student    SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy ShuttleUser   @relation("PlannedAbsenceRecordedBy", fields: [recordedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([date, appliedAt])
  @@index([studentId, date])
}

/// نوع وموقع الالتقاط للطالب
model StudentPickupConfig {
  id             String     @id @default(uuid())
  studentId      String     @unique
  pickupType     PickupType
  meetingPointId String?
  latitude       Float?
  longitude      Float?
  addressLabel   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  student      SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingPoint MeetingPoint? @relation(fields: [meetingPointId], references: [id])

  @@index([meetingPointId])
}

/// طالب الجامعة — يملك حساباً ويسجل دخوله بنفسه
model UniversityStudentProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  institutionId String
  branchId      String?
  studentNumber String?
  faculty       String?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  user        ShuttleUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      InstitutionBranch? @relation(fields: [branchId], references: [id])

  @@unique([institutionId, studentNumber])
  @@index([institutionId, status])
}

/// تفضيل ولي الأمر لتنبيه اقتراب الباص (5 / 10 / 15 دقيقة)
model ParentArrivalPreference {
  id            String   @id @default(uuid())
  parentUserId  String
  studentId     String
  minutesBefore Int      @default(10)
  soundEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentUser ShuttleUser   @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student    SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
}

// =============================================================================
// TRANSPORT CONFIG: MEETING POINTS / ROUTES / SCHEDULES / STOPS
// =============================================================================

model MeetingPoint {
  id            String         @id @default(uuid())
  institutionId String
  branchId      String?
  name          String
  latitude      Float
  longitude     Float
  addressLabel  String?
  status        ResourceStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      InstitutionBranch? @relation(fields: [branchId], references: [id])

  pickupConfigs StudentPickupConfig[]
  routeStops    RouteStop[]

  @@index([institutionId, status])
}

/// الخط — الإعداد الثابت والمتكرر
model ShuttleRoute {
  id            String      @id @default(uuid())
  institutionId String
  branchId      String
  name          String
  code          String?
  status        RouteStatus @default(ACTIVE)

  /// نقطة انطلاق المركبة الأساسية
  originLabel String?
  originLat   Float
  originLng   Float

  /// تجاوز عتبة التأخير على مستوى الخط (null = استخدام إعداد المؤسسة)
  delayThresholdMinutes Int?

  /// هندسة الشوارع المخزّنة (encoded polyline) — تُحدَّث عند تغيّر المحطات
  polylineOutbound    String?
  polylineInbound     String?
  polylinePrecision   Int       @default(6)
  polylineUpdatedAt   DateTime?

  /// التعيينات الأساسية
  defaultDriverId    String?
  defaultVehicleId   String?
  defaultAttendantId String? @unique

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch           InstitutionBranch @relation(fields: [branchId], references: [id])
  defaultDriver    DriverProfile?    @relation(fields: [defaultDriverId], references: [id])
  defaultVehicle   ShuttleVehicle?   @relation(fields: [defaultVehicleId], references: [id])
  defaultAttendant AttendantProfile? @relation(fields: [defaultAttendantId], references: [id])

  schedules          RouteSchedule[]
  stops              RouteStop[]
  studentAssignments StudentRouteAssignment[]
  routeExceptions    StudentRouteException[]
  trips              ShuttleTrip[]
  notifications      ShuttleNotification[]

  @@unique([institutionId, name])
  @@index([institutionId, branchId, status])
  @@index([status])
}

/// جدول التشغيل — المدرسة: ذهاب + عودة. الجامعة: عدة أوقات لكل اتجاه.
model RouteSchedule {
  id            String        @id @default(uuid())
  routeId       String
  direction     TripDirection
  /// "HH:mm" بالتوقيت المحلي للمؤسسة
  departureTime String
  /// 1 = الاثنين ... 7 = الأحد (ISO)
  daysOfWeek    Int[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  route ShuttleRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  trips ShuttleTrip[]

  @@unique([routeId, direction, departureTime])
  @@index([routeId, isActive])
}

/// محطة في الخط (بترتيب لكل اتجاه)
model RouteStop {
  id               String        @id @default(uuid())
  routeId          String
  direction        TripDirection
  sequence         Int
  stopType         StopType
  label            String?
  latitude         Float
  longitude        Float
  meetingPointId   String?
  /// تقدير ثابت بالدقائق من نقطة الانطلاق (يُحدّث عند optimize)
  etaOffsetMinutes Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  route        ShuttleRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  meetingPoint MeetingPoint? @relation(fields: [meetingPointId], references: [id])

  students  RouteStopStudent[]
  tripStops TripStop[]

  @@unique([routeId, direction, sequence])
  @@index([routeId, direction])
}

/// ربط الطلاب بالمحطة (محطة المنزل = طالب واحد، نقطة التجمع = عدة طلاب)
model RouteStopStudent {
  id          String   @id @default(uuid())
  routeStopId String
  studentId   String
  createdAt   DateTime @default(now())

  routeStop RouteStop     @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  student   SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([routeStopId, studentId])
  @@index([studentId])
}

/// ربط الطالب بخطه الأساسي (تاريخي: السجل القديم يُغلق بـ endedAt)
model StudentRouteAssignment {
  id        String    @id @default(uuid())
  studentId String
  routeId   String
  isActive  Boolean   @default(true)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  student SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   ShuttleRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([studentId, isActive])
  @@index([routeId, isActive])
}

/// استثناء مؤقت: الطالب يعود/يذهب مع خط آخر في يوم محدد
model StudentRouteException {
  id              String         @id @default(uuid())
  studentId       String
  overrideRouteId String
  /// null = الاتجاهان
  direction       TripDirection?
  date            DateTime       @db.Date
  reason          String?
  createdByUserId String
  createdAt       DateTime       @default(now())

  student       SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overrideRoute ShuttleRoute  @relation(fields: [overrideRouteId], references: [id], onDelete: Cascade)
  createdByUser ShuttleUser   @relation("RouteExceptionCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([studentId, date, direction])
  @@index([date])
}

// =============================================================================
// OPERATIONS: TRIPS
// =============================================================================

/// الرحلة — تنفيذ فعلي للخط في يوم ووقت معين
model ShuttleTrip {
  id            String        @id @default(uuid())
  institutionId String
  branchId      String
  routeId       String
  scheduleId    String?
  direction     TripDirection
  status        TripStatus    @default(SCHEDULED)

  serviceDate            DateTime @db.Date
  scheduledDepartureTime String

  /// snapshot من الخط + أي تعديل استثنائي
  originLabel String?
  originLat   Float
  originLng   Float

  driverId    String?
  vehicleId   String?
  attendantId String?

  /// تأكيد السائق لصعود المشرفة إلى الحافلة
  attendantBoarded         Boolean   @default(false)
  attendantBoardedAt       DateTime?
  attendantBoardedByUserId String?

  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  /// مسافة فعلية (كم) تُحسب من نقاط الموقع عند الإكمال
  distanceKm Float?

  /// حساب التأخير
  delayThresholdMinutes Int
  delayMinutes          Int       @default(0)
  delayDetectedAt       DateTime?
  delayAlertSentAt      DateTime?

  /// آخر حالة تتبع (مرآة مختصرة لما في Redis)
  lastLocationLat Float?
  lastLocationLng Float?
  lastLocationAt  DateTime?
  etaToNextStopAt DateTime?
  etaToFinishAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      InstitutionBranch @relation(fields: [branchId], references: [id])
  route       ShuttleRoute      @relation(fields: [routeId], references: [id])
  schedule    RouteSchedule?    @relation(fields: [scheduleId], references: [id])
  driver      DriverProfile?    @relation(fields: [driverId], references: [id])
  vehicle     ShuttleVehicle?   @relation(fields: [vehicleId], references: [id])
  attendant   AttendantProfile? @relation(fields: [attendantId], references: [id])
  attendantBoardedByUser ShuttleUser? @relation("TripAttendantBoardedBy", fields: [attendantBoardedByUserId], references: [id])

  stops             TripStop[]
  students          TripStudent[]
  events            TripEvent[]
  assignmentHistory TripAssignmentHistory[]
  locationPings     TripLocationPing[]
  incidents         TripIncident[]
  alertDeliveries   TripAlertDelivery[]

  @@unique([routeId, serviceDate, direction, scheduledDepartureTime])
  @@index([institutionId, serviceDate, status])
  @@index([branchId, serviceDate])
  @@index([driverId, serviceDate])
  @@index([status, serviceDate])
  @@index([institutionId, branchId, serviceDate])
}

model TripStop {
  id               String         @id @default(uuid())
  tripId           String
  routeStopId      String?
  sequence         Int
  stopType         StopType
  label            String?
  latitude         Float
  longitude        Float
  status           TripStopStatus @default(PENDING)
  plannedArrivalAt DateTime?
  etaAt            DateTime?
  arrivedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trip      ShuttleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  routeStop RouteStop?  @relation(fields: [routeStopId], references: [id])

  students TripStudent[]

  @@unique([tripId, sequence])
  @@index([tripId, status])
}

model TripStudent {
  id             String            @id @default(uuid())
  tripId         String
  studentId      String
  tripStopId     String?
  status         TripStudentStatus @default(PENDING)
  /// true إذا كان الطالب على هذه الرحلة بسبب StudentRouteException
  isException    Boolean           @default(false)
  boardedAt      DateTime?
  droppedOffAt   DateTime?
  notBoardedAt   DateTime?
  markedByUserId String?
  correctedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  trip         ShuttleTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student      SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tripStop     TripStop?     @relation(fields: [tripStopId], references: [id])
  markedByUser ShuttleUser?  @relation("TripStudentMarkedBy", fields: [markedByUserId], references: [id])

  @@unique([tripId, studentId])
  @@index([studentId, createdAt])
  @@index([tripId, status])
}

/// سجل التبديلات (سائق/مركبة/مشرفة) أثناء الرحلة
model TripAssignmentHistory {
  id              String              @id @default(uuid())
  tripId          String
  field           TripAssignmentField
  previousId      String?
  previousLabel   String?
  newId           String?
  newLabel        String?
  reason          String?
  incidentId      String?
  changedByUserId String
  changedAt       DateTime            @default(now())

  trip          ShuttleTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  changedByUser ShuttleUser   @relation("AssignmentChangedBy", fields: [changedByUserId], references: [id])
  incident      TripIncident? @relation(fields: [incidentId], references: [id])

  @@index([tripId, changedAt])
}

/// نقاط GPS المحفوظة (sampling؛ الحي في Redis) — تُنظّف دورياً
model TripLocationPing {
  id         String   @id @default(uuid())
  tripId     String
  latitude   Float
  longitude  Float
  speedKph   Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime

  trip ShuttleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@index([recordedAt])
}

/// الأعطال والطوارئ
model TripIncident {
  id               String         @id @default(uuid())
  tripId           String
  type             IncidentType
  status           IncidentStatus @default(OPEN)
  reportedByUserId String
  description      String?
  latitude         Float?
  longitude        Float?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNotes  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trip           ShuttleTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reportedByUser ShuttleUser  @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])
  resolvedByUser ShuttleUser? @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id])

  assignmentChanges TripAssignmentHistory[]

  @@index([tripId, status])
  @@index([status, createdAt])
}

/// Timeline موحّد لكل ما يحدث في الرحلة
model TripEvent {
  id          String        @id @default(uuid())
  tripId      String
  type        TripEventType
  actorUserId String?
  title       String
  description String?
  data        Json?
  occurredAt  DateTime      @default(now())

  trip      ShuttleTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actorUser ShuttleUser? @relation("TripEventActor", fields: [actorUserId], references: [id])

  @@index([tripId, occurredAt])
  @@index([type])
}

// =============================================================================
// COMMUNICATION
// =============================================================================

/// إشعار مُرسل (يدوي من المؤسسة أو تلقائي من النظام)
model ShuttleNotification {
  id              String               @id @default(uuid())
  institutionId   String
  branchId        String?
  routeId         String?
  audience        NotificationAudience
  origin          NotificationOrigin   @default(MANUAL)
  title           String
  body            String
  data            Json?
  recipientsCount Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  sentByUserId    String?
  createdAt       DateTime             @default(now())

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      InstitutionBranch? @relation(fields: [branchId], references: [id])
  route       ShuttleRoute?      @relation(fields: [routeId], references: [id])
  sentByUser  ShuttleUser?       @relation("NotificationSentBy", fields: [sentByUserId], references: [id])

  recipients NotificationRecipient[]

  @@index([institutionId, createdAt])
  @@index([routeId, createdAt])
  @@index([institutionId, branchId, createdAt])
}

model NotificationRecipient {
  id             String         @id @default(uuid())
  notificationId String
  userId         String
  status         DeliveryStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  errorMessage   String?
  createdAt      DateTime       @default(now())

  notification ShuttleNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         ShuttleUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, readAt])
}

/// تنبيهات مرتبطة برحلة (اقتراب / تأخير) — تُستخدم لمنع التكرار
model TripAlertDelivery {
  id        String         @id @default(uuid())
  tripId    String
  userId    String
  studentId String?
  type      TripAlertType
  status    DeliveryStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())

  trip ShuttleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user ShuttleUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, type, studentId])
  @@index([tripId, type])
}

// =============================================================================
// SYSTEM
// =============================================================================

/// إعدادات المنصة (صف واحد): الدعم، التتبع العام، وإصدارات تطبيقات الموبايل.
model PlatformSetting {
  id           String   @id
  supportPhone String?

  /// افتراضي لكل المؤسسات إن لم تُضبط قيمة خاصة بها.
  gpsStaleAfterSeconds        Int @default(120)
  locationPingIntervalSeconds Int @default(15)

  driverIosMinVersion        String  @default("1.0.0")
  driverIosLatestVersion     String  @default("1.0.0")
  driverAndroidMinVersion    String  @default("1.0.0")
  driverAndroidLatestVersion String  @default("1.0.0")
  driverIosUrl               String?
  driverAndroidUrl           String?
  driverForceMessage         String?

  attendantIosMinVersion        String  @default("1.0.0")
  attendantIosLatestVersion     String  @default("1.0.0")
  attendantAndroidMinVersion    String  @default("1.0.0")
  attendantAndroidLatestVersion String  @default("1.0.0")
  attendantIosUrl               String?
  attendantAndroidUrl           String?
  attendantForceMessage         String?

  parentIosMinVersion        String  @default("1.0.0")
  parentIosLatestVersion     String  @default("1.0.0")
  parentAndroidMinVersion    String  @default("1.0.0")
  parentAndroidLatestVersion String  @default("1.0.0")
  parentIosUrl               String?
  parentAndroidUrl           String?
  parentForceMessage         String?

  universityIosMinVersion        String  @default("1.0.0")
  universityIosLatestVersion     String  @default("1.0.0")
  universityAndroidMinVersion    String  @default("1.0.0")
  universityAndroidLatestVersion String  @default("1.0.0")
  universityIosUrl               String?
  universityAndroidUrl           String?
  universityForceMessage         String?

  supportWhatsappUrl String?

  maintenanceApps      Boolean @default(false)
  maintenanceDashboard Boolean @default(false)
  maintenanceMessageAr String?
  maintenanceMessageEn String?

  announcementEnabled Boolean @default(false)
  announcementTitleAr String?
  announcementBodyAr  String?
  announcementTitleEn String?
  announcementBodyEn  String?

  fcmParents    Boolean @default(true)
  fcmUniversity Boolean @default(true)
  fcmDrivers    Boolean @default(true)
  fcmAttendants Boolean @default(true)
  fcmAdmins     Boolean @default(true)

  templateDelayTitleAr      String @default("الرحلة متأخرة")
  templateDelayBodyAr       String @default("هذه الرحلة متأخرة حوالي {minutes} دقيقة عن الجدول.")
  templateDelayTitleEn      String @default("Trip delayed")
  templateDelayBodyEn       String @default("This trip is about {minutes} minutes behind schedule.")
  templateEmergencyTitleAr  String @default("طوارئ في رحلة")
  templateEmergencyBodyAr   String @default("تم الضغط على زر الطوارئ.")
  templateEmergencyTitleEn  String @default("Emergency on a trip")
  templateEmergencyBodyEn   String @default("An emergency button was pressed.")
  templateArrivalTitleAr    String @default("الحافلة تقترب")
  templateArrivalBodyAr     String @default("حافلة {studentName} على بعد حوالي {minutes} دقيقة.")
  templateArrivalTitleEn    String @default("Bus is approaching")
  templateArrivalBodyEn     String @default("{studentName}'s bus is about {minutes} minutes away.")

  updatedAt DateTime @updatedAt @default(now())
}

enum AppBrandingApp {
  PASSENGER
  CREW
}

/// White-label config for the two Flutter apps (passenger + crew).
/// `published` is what mobile reads; `draft` is what the dashboard edits.
model PlatformAppBranding {
  id        String          @id @default(uuid())
  appKey    AppBrandingApp  @unique
  version   Int             @default(0)
  published Json
  draft     Json
  updatedAt DateTime        @updatedAt @default(now())
}

model ShuttleAuditLog {
  id            String   @id @default(uuid())
  institutionId String?
  actorUserId   String
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  actorUser   ShuttleUser  @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([institutionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
