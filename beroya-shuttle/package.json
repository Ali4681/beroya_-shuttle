{
  "name": "beroya-shuttle-api",
  "version": "0.0.1",
  "description": "Beroya On + backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma migrate deploy && prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/swagger/**/*.ts\" \"src/modules/**/*.rules.ts\" \"src/modules/**/*.rules.spec.ts\" \"src/modules/notifications/notification-audience.*\" \"src/infra/queue/job-windows.ts\" \"src/infra/queue/jobs.catalog.ts\" \"src/infra/queue/*.spec.ts\" \"src/infra/routing/haversine.ts\" \"src/infra/routing/haversine.spec.ts\" \"scripts/verify-phase14.ts\" \"test/testcontainers.e2e-spec.ts\" \"test/app.e2e-spec.ts\" \"test/phase14.e2e-spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "explain:hot": "tsx scripts/explain-hot-queries.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "verify:phase14": "tsx scripts/verify-phase14.ts",
    "docs:phase15": "tsx scripts/generate-phase15-plans.ts",
    "verify:phase15": "tsx scripts/verify-phase15.ts",
    "staging:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d postgres redis minio && docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build migrate && docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d api worker",
    "test:cov:phase14": "jest --coverage --runInBand --collectCoverageFrom=\"modules/**/*.rules.ts\" --collectCoverageFrom=\"modules/notifications/notification-audience.service.ts\" --collectCoverageFrom=\"modules/tracking/eta.rules.ts\" --collectCoverageFrom=\"infra/queue/job-windows.ts\" --collectCoverageFrom=\"infra/routing/haversine.ts\" --collectCoverageFrom=\"swagger/swagger-contract.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:reset": "tsx prisma/seed.ts --reset",
    "prisma:seed:live": "tsx prisma/seed.ts --live",
    "prisma:studio": "prisma studio",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "verify:phase8": "tsx scripts/verify-phase8.ts",
    "verify:phase9": "tsx scripts/verify-phase9.ts",
    "verify:phase10": "tsx scripts/verify-phase10.ts",
    "verify:phase11": "tsx scripts/verify-phase11.ts",
    "verify:phase12": "tsx scripts/verify-phase12.ts",
    "verify:phase13": "tsx scripts/verify-phase13.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.2.0",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/image-size": "^0.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "modules/**/*.rules.ts",
      "modules/notifications/notification-audience.service.ts",
      "modules/tracking/eta.rules.ts",
      "infra/queue/job-windows.ts",
      "infra/routing/haversine.ts",
      "swagger/swagger-contract.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 70
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
